
@imports('__sandbox__', _as='sandbox')
def cdef(name, value):
    val = sandbox._resolve(value)
    sandbox.set_config_impl(name, val)
    sandbox.set_define_impl(name, val)

set_define('JS_PUNBOX64', depends(target)(lambda t: t.bitness == 64 or None))
set_define('JS_NUNBOX32', depends(target)(lambda t: t.bitness == 32 or None))

# JIT support
# =======================================================
@depends('--enable-jit', target)
def enable_jit(value, target):
    if not value:
        return

    if target.cpu in ('x86', 'x86_64', 'arm', 'aarch64', 'mips32', 'mips64'):
        return True

# JIT code simulator for cross compiles
# =======================================================
@depends(moz_debug)
def disasm(debug):
    def disasm_func(arch):
        if not debug:
            return

        if arch in ['arm', 'arm64']:
            cdef('JS_DISASM_%s' % arch.upper(), True)

    return disasm_func

@depends(enable_jit, '--enable-simulator', target, disasm)
@imports('sys')
def simulator(jit, sim, target, disasm):
    if not jit or not sim:
        return
    sim = sim[0]

    sim_arch32 = ['arm', 'mips32']
    sim_arch64 = ['arm64', 'mips64']
    sim_arch = sim_arch32 + sim_arch64
    sim_arch.sort()

    if not sim in sim_arch:
        log.error("Invalid %s simulator. Valid simulators are: %s." % (sim, ', '.join(sim_arch)))
        sys.exit(1)

    arch = sim.upper()
    if sim in sim_arch32:
        if target.cpu != 'x86':
            log.error("The %s simulator only works on x86." % (arch))
            sys.exit(1)
    elif sim in sim_arch64:
        if target.cpu != 'x86_64':
            log.error("The %s simulator only works on x86_64." % (arch))
            sys.exit(1)

    cdef('JS_SIMULATOR_%s' % arch, True)
    cdef('JS_CODEGEN_%s' % arch, True)
    disasm(sim)

    return True

cdef('JS_SIMULATOR', simulator)

@depends(enable_jit, simulator, target, disasm)
def codegen(jit, sim, target, disasm):
    if not jit:
        return True

    if sim:
        return

    cpu = target.cpu
    if cpu == 'x86_64':
        cpu = 'x64'
    elif cpu == 'aarch64':
        cpu = 'arm64'

    cdef('JS_CODEGEN_%s' % cpu.upper(), True)
    disasm(cpu)

cdef('JS_CODEGEN_NONE', codegen)